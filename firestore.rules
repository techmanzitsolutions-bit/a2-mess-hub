rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userPath(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile(){ return signedIn() && exists(userPath()); }
    function role(){ return hasProfile() ? get(userPath()).data.role : null; }
    function admin(){ return signedIn() && role() == 'admin'; }
    function chef(){ return signedIn() && role() == 'chef'; }
    function member(){ return signedIn() && role() == 'member'; }
    function initialized(){ return exists(/databases/$(database)/documents/system/config); }

    match /system/config {
      allow read: if true;
      allow create: if signedIn()
                    && !initialized()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.initialized == true;
      allow update, delete: if admin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && !initialized()
                        && request.resource.data.role == 'admin'
                        && request.resource.data.active == true);
      allow update: if admin();
      allow delete: if admin() && uid != request.auth.uid;
    }

    match /members/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /inventory/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || chef();
      allow delete: if admin();
    }
    match /meals/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || chef();
      allow delete: if admin();
    }
    match /mealSkips/{id} {
      allow read: if signedIn();
      allow create: if member()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'SKIPPED';
      allow update: if member()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if admin()
                    || (member() && resource.data.uid == request.auth.uid);
    }
    match /expenses/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (admin() || chef());
      allow update, delete: if admin();
    }
    match /payments/{id} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /monthlyClosings/{month} {
      allow read, create, update, delete: if admin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /notifications/{id} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
  }
}
