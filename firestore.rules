rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(){ return signedIn() ? me().data.role : null; }
    function admin(){ return signedIn() && role() == 'admin'; }
    function chef(){ return signedIn() && role() == 'chef'; }
    function member(){ return signedIn() && role() == 'member'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /members/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /inventory/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || chef();
      allow delete: if admin();
    }
    match /meals/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || chef();
      allow delete: if admin();
    }
    match /expenses/{id} {
      allow read: if signedIn() && (admin() || chef());
      allow create: if signedIn() && (admin() || chef());
      allow update, delete: if admin();
    }
    match /payments/{id} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /notifications/{id} {
      allow read: if admin();
      allow create: if admin();
      allow update, delete: if false;
    }
  }
}
